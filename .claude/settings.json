{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.production)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin develop*)",
      "Edit(./.claude/rules/**)",
      "Edit(./.claude/skills/**)",
      "Edit(./.claude/agents/**)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(git tag *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh issue create *)",
      "Bash(gh release create *)",
      "Bash(gh pr review *)",
      "Bash(gh pr comment *)",
      "Bash(gh issue comment *)"
    ],
    "additionalDirectories": [
      "../chagok-docs",
      "../chagok-backend"
    ]
  }
}
