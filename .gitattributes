# 기본: 저장소에는 LF로 저장 (Windows·Mac 혼용 시 줄바꿈 차이로 생기는 가짜 변경 방지)
* text=auto eol=lf

# Windows 실행 파일은 CRLF 유지
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 셸 스크립트는 LF (CRLF면 실행 오류)
*.sh text eol=lf

# 바이너리
*.jar binary
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
*.svg text eol=lf
*.woff2 binary
